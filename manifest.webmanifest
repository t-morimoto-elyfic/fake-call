    },
    {
      "purpose": "any",
      "sizes": "512x512",
      "src": "icons/icon-512.png",
      "type": "image/png"
    },
    {
      "purpose": "maskable",
      "sizes": "512x512",
      "src": "icons/icon-512.png",
      "type": "image/png"
    },
    {
      "purpose": "any",
      "sizes": "180x180",
      "src": "icons/apple-touch-icon.png",
      "type": "image/png"
    }
  ],
  "lang": "ja",
  "name": "フェイク着信",
  "orientation": "portrait",
  "scope": "./",
